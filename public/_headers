# Cloudflare cache policy for the Finjaro SPA.
# Content-hashed assets are immutable and cached hard; the shell + service
# worker must always revalidate so a new deploy takes effect immediately
# (no reinstall). Mirrors the old netlify.toml headers, now on Cloudflare.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/demo-products/*
  Cache-Control: public, max-age=604800

/demo-reels/*
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

/leo/visages/*
  Cache-Control: public, max-age=2592000

# En-têtes de sécurité sur tout le site (audit du 01/10, M-1) — les mêmes que
# EN_TETES_SECURITE dans src/worker.js, pour les fichiers servis sans lui.
/*
  Strict-Transport-Security: max-age=15552000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self' https://*.finjaro.net https://*.finjaro.workers.dev
