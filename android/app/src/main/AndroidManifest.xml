<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->
    <!--
    Sans ces lignes, Android REFUSE la demande AVANT même qu'une fenêtre
    d'autorisation puisse s'afficher — pas de refus visible, juste rien: la
    position ne revient jamais, l'appareil photo peut se comporter de façon
    imprévisible selon la version d'Android. Contrairement à iOS (où l'absence
    du texte ferme carrément l'app), ici le symptôme est silencieux, ce qui le
    rend plus difficile à repérer — c'est exactement ce que Beau a constaté:
    « on ne m'a rien demandé ».

    Ces droits eux-mêmes ne montrent aucune fenêtre: c'est ce qui permet à
    Android de savoir qu'IL A LE DROIT de demander, ensuite. La fenêtre que
    la personne voit vient du navigateur (WebView) au moment où la page
    appelle réellement la caméra ou la position — comme sur iOS.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
    Micro: la dictée vocale de Finou (bouton micro dans la barre de saisie).
    Même mécanisme que la caméra ci-dessus, même oubli, même symptôme, constaté
    par Beau le 11/09 sur l'app installée: « impossible d'accéder au micro,
    vérifiez les réglages » au lieu de la fenêtre « Autoriser ». iOS, lui,
    déclare déjà le micro dans Info.plist (NSMicrophoneUsageDescription).
    MODIFY_AUDIO_SETTINGS accompagne RECORD_AUDIO: la capture audio du WebView
    le demande pour régler l'entrée son.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
