+// @vitest-environment node
+import { describe, it, expect } from 'vitest';
+import { choisirFormule, formuleDe, modelesPermis, plafondPour, MODELES_GRATUITS } from '../src/formule.js';
+import { ordre, disponibles } from '../src/moteur.js';
+import { outilsPourMode } from '../src/politique.js';
+import { envoyer, consigneSysteme } from '../src/boucle.js';
+import { identifier } from '../src/supabase.js';
+import { fauxFichiers, fauxBac, fauxModele, fausseDeps, fauxEtat } from './faux.js';
+
+const TOUTES_LES_CLES = { DEEPSEEK_API_KEY: 'x', KIMI_API_KEY: 'x', GEMINI_API_KEY: 'x', OPENAI_API_KEY: 'sk-x' };
+
+describe('les formules de l\'atelier', () => {
+  it('Premium par la liste du Worker ou par une entreprise Premium ; gratuit sinon', () => {
+    expect(choisirFormule({ dansListe: true })).toBe('premium');
+    expect(choisirFormule({ entreprisesPremium: 1 })).toBe('premium');
+    expect(choisirFormule({})).toBe('gratuit');
+    expect(formuleDe('nimporte').nom).toBe('gratuit'); // une valeur inconnue ne donne jamais Premium
+  });
+
+  it('gratuit : modèles les moins chers, petit plafond, jamais au-dessus du Worker', () => {
+    expect(modelesPermis('gratuit', ['oa:gpt-6-sol', 'ds:deepseek-flash', 'gm:gemini-2.5-flash'])).toEqual(['ds:deepseek-flash', 'gm:gemini-2.5-flash']);
+    expect(modelesPermis('premium', ['oa:gpt-6-sol', 'ds:deepseek-flash'])).toEqual(['oa:gpt-6-sol', 'ds:deepseek-flash']);
+    expect(plafondPour('gratuit', 1)).toBe(0.05);
+    expect(plafondPour('gratuit', 0.02)).toBe(0.02);
+    expect(plafondPour('premium', 1)).toBe(1);
+  });
+
+  it('les clés du Worker ne contournent pas la formule', () => {
+    expect(disponibles(TOUTES_LES_CLES, { permis: MODELES_GRATUITS })).toEqual(['ds:deepseek-flash', 'gm:gemini-2.5-flash']);
+    // Auto en gratuit : les modèles permis, dans leur ordre ; un modèle fort choisi retombe sur Auto.
+    expect(ordre(TOUTES_LES_CLES, 'auto', { permis: MODELES_GRATUITS })).toEqual(['ds:deepseek-flash', 'gm:gemini-2.5-flash']);
+    expect(ordre(TOUTES_LES_CLES, 'oa:gpt-6-astra', { permis: MODELES_GRATUITS })).toEqual(['ds:deepseek-flash', 'gm:gemini-2.5-flash']);
+    // Premium : inchangé.
+    expect(ordre(TOUTES_LES_CLES, 'oa:gpt-6-astra', {})).toEqual(['oa:gpt-6-astra']);
+  });
+
+  it('sans machine, l\'agent ne reçoit pas l\'outil « commande »', () => {
+    expect(outilsPourMode('auto', false, false)).not.toContain('commande');
+    expect(outilsPourMode('auto', false, false)).toContain('ecrire_fichier');
+    expect(outilsPourMode('auto')).toContain('commande');
+    expect(consigneSysteme(fauxEtat(), null, { sansMachine: true })).toContain('FORMULE GRATUITE');
+    expect(consigneSysteme(fauxEtat(), null)).not.toContain('FORMULE GRATUITE');
+  });
+
+  it('sans machine, une commande demandée quand même est refusée sans toucher au bac', async () => {
+    const f = fauxFichiers({ 'index.html': '<h1>Salut</h1>' });
+    const bac = fauxBac(f, {});
+    const modele = fauxModele([
+      { outils: [['commande', { commande: 'npm install', pourquoi: 'installer' }]] },
+      { texte: 'D\'accord, je fais sans.' },
+    ]);
+    const deps = { ...fausseDeps({ fichiers: f, bac, fetchFn: modele.fetchFn }), sansMachine: true, permis: MODELES_GRATUITS };
+    const etat = fauxEtat(0.05);
+    etat.mode = 'auto';
+    await envoyer(etat, deps, 'installe les dépendances');
+    expect(bac.lancees).toEqual([]);
+    expect(modele.requetes[0].corps.tools.map((t) => t.function.name)).not.toContain('commande');
+    expect(modele.requetes[0].corps.model).toBe('deepseek-flash');
+    const retour = modele.requetes[1].corps.messages.find((m) => m.role === 'tool');
+    expect(retour.content).toMatch(/Premium/);
+  });
+});
+
+describe('la porte du Worker', () => {
+  const env = { SUPABASE_URL: 'https://x.supabase.co', SUPABASE_ANON_KEY: 'publique', ATELIER_UTILISATEURS: 'u-liste' };
+  const faux = (id, premium) => async (url) => {
+    if (url.endsWith('/auth/v1/user')) return Response.json({ id, email: `${id}@essai` });
+    if (url.includes('legion_entreprises')) return premium === 'panne' ? new Response('non', { status: 500 }) : Response.json(premium ? [{ id: 'e1' }] : []);
+    throw new Error(`inattendu : ${url}`);
+  };
+
+  it('tout compte connecté entre ; la formule suit les entreprises Premium', async () => {
+    expect(await identifier(env, 'j-gratuit', faux('u1', false))).toMatchObject({ autorise: true, formule: 'gratuit' });
+    expect(await identifier(env, 'j-premium', faux('u2', true))).toMatchObject({ autorise: true, formule: 'premium' });
+    expect(await identifier(env, 'j-liste', faux('u-liste', false))).toMatchObject({ formule: 'premium' });
+    // Une lecture en panne laisse la formule gratuite, jamais Premium.
+    expect(await identifier(env, 'j-panne', faux('u3', 'panne'))).toMatchObject({ formule: 'gratuit' });
+  });
+
+  it('sans session valide, personne n\'entre', async () => {
+    expect(await identifier(env, 'j-mort', async () => new Response('', { status: 401 }))).toBeNull();
+    expect(await identifier(env, '', faux('u1', true))).toBeNull();
+  });
+});
