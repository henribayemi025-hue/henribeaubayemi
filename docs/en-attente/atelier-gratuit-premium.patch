+// LES DEUX FORMULES DE L'ATELIER (Beau, 02/10 : « comme VS Code : ça marche
+// normalement même si tu ne payes pas, seulement certaines fonctionnalités
+// ne marchent pas »).
+//
+// - GRATUIT, pour tout compte connecté (Léo ou Learn, le même compte) :
+//   l'éditeur, les fichiers du projet, l'aperçu de la page (il tourne dans le
+//   navigateur de la personne : il ne nous coûte rien), l'agent avec les
+//   modèles les moins chers, un petit plafond par séance. Pas de machine :
+//   ni terminal, ni commande lancée par l'agent (le conteneur est ce qui
+//   coûte).
+// - PREMIUM : tout — la machine (terminal, npm, Python), tous les modèles,
+//   le plafond de séance réglé dans le Worker, l'équipe de Léo. Accordé à
+//   une entreprise par l'équipe Finjaro seulement (legion_entreprises.premium,
+//   protégé par un déclencheur), ou à un identifiant de ATELIER_UTILISATEURS.
+//
+// Ce module est pur : testé tel quel (test/formule.test.js). La fonction
+// Supabase atelier-modele applique les MÊMES modèles et son propre plafond
+// du jour : le Worker ne décide pas seul de ce qui se dépense.
+
+// Les moins chers des modèles publiés (cout.js) : quelques centimes pour une
+// vraie séance de travail. Dans l'ordre d'« Auto ».
+export const MODELES_GRATUITS = ['ds:deepseek-flash', 'gm:gemini-2.5-flash'];
+
+export const FORMULES = {
+  gratuit: {
+    nom: 'gratuit',
+    machine: false,
+    modeles: MODELES_GRATUITS,
+    plafondSessionUsd: 0.05,
+    projetsMax: 5,
+  },
+  premium: {
+    nom: 'premium',
+    machine: true,
+    modeles: null, // tous ceux qui ont une clé
+    plafondSessionUsd: null, // celui du Worker (ATELIER_PLAFOND_SESSION_USD)
+    projetsMax: 30,
+  },
+};
+
+export function formuleDe(nom) {
+  return FORMULES[nom] || FORMULES.gratuit;
+}
+
+// Premium si l'identifiant est dans la liste du Worker, ou si la personne
+// voit au moins une entreprise Premium dont elle est membre.
+export function choisirFormule({ dansListe = false, entreprisesPremium = 0 } = {}) {
+  return dansListe || entreprisesPremium > 0 ? 'premium' : 'gratuit';
+}
+
+// Les modèles qu'une formule permet, parmi ceux qui sont joignables.
+export function modelesPermis(formule, modeles) {
+  const f = formuleDe(formule);
+  return f.modeles ? modeles.filter((m) => f.modeles.includes(m)) : [...modeles];
+}
+
+// Le plafond d'une séance : jamais plus haut que celui du Worker.
+export function plafondPour(formule, plafondWorker) {
+  const f = formuleDe(formule);
+  return f.plafondSessionUsd == null ? plafondWorker : Math.min(f.plafondSessionUsd, plafondWorker);
+}
+
+export const MESSAGE_SANS_MACHINE = 'Le terminal et les commandes font partie de l\'atelier Premium. En gratuit, tu gardes l\'éditeur, l\'aperçu de la page et l\'agent pour écrire le code.';
