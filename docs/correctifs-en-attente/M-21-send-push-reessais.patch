+// Resend limite à 10 requêtes par seconde : quand plusieurs notifications
+// partent ensemble, des lots reviennent en 429 (68 e-mails perdus le 30/09 à
+// 9 h 34, audit M-21). On réessaie un lot refusé pour 429 ou 5xx, au plus 3
+// fois, après le délai demandé par Resend (retry-after) ou 1 s, 2 s, 4 s.
+const ESSAIS_EMAIL = 3;
+export function delaiAvantNouvelEssai(status: number, retryAfter: string | null, essai: number): number | null {
+  if (essai >= ESSAIS_EMAIL) return null;
+  if (status !== 429 && status < 500) return null;
+  const demande = Number(retryAfter);
+  const base = Number.isFinite(demande) && demande > 0 ? demande * 1000 : 1000 * 2 ** (essai - 1);
+  return Math.min(base, 8000) + Math.floor(Math.random() * 250);
+}
