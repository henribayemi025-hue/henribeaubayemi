# Fabrication et envoi de l'app iOS. Appelé par .github/workflows/ios.yml.
#
# POURQUOI FASTLANE ET PAS `xcodebuild` SEUL
# Quatre essais ont échoué avec la signature automatique de Xcode, et le
# quatrième a donné la raison de fond: en signature automatique, Xcode ne
# signe qu'en DÉVELOPPEMENT, et un profil de développement exige au moins un
# iPhone enregistré dans le compte. Une machine de CI n'en a aucun. Toute
# tentative d'imposer « Apple Distribution » se solde par « conflicting
# provisioning settings ».
# La sortie, c'est la signature MANUELLE: on demande à Apple un certificat de
# distribution et un profil App Store, on les installe, puis on archive en
# les désignant explicitement. `cert` et `sigh` font exactement cela à partir
# de la clé d'API, et réutilisent ce qui existe déjà au lieu d'en recréer à
# chaque exécution — Apple limite le nombre de certificats de distribution.
default_platform(:ios)

APP_ID = 'net.finjaro.app'
TEAM_ID = 'CP87XRK5CD'
PROJECT = 'ios/App/App.xcodeproj'

platform :ios do
  desc 'Archive signée et envoi à App Store Connect'
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('APPSTORE_API_KEY_ID'),
      issuer_id: ENV.fetch('APPSTORE_API_ISSUER_ID'),
      key_filepath: ENV.fetch('ASC_KEY_PATH'),
    )

    # Trousseau temporaire, déverrouillé pour la durée du job: le certificat
    # doit être rangé quelque part d'accessible, et celui de la machine ne
    # l'est pas.
    setup_ci

    get_certificates(api_key: api_key, development: false)
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_ID,
      # Le profil App Store, celui qui n'exige aucun appareil enregistré.
      adhoc: false,
      development: false,
    )

    update_code_signing_settings(
      path: PROJECT,
      targets: ['App'],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      bundle_identifier: APP_ID,
      code_sign_identity: 'Apple Distribution',
      profile_name: lane_context[SharedValues::SIGH_NAME],
    )

    build = ENV.fetch('BUILD_NUMBER')
    build_app(
      project: PROJECT,
      scheme: 'App',
      configuration: 'Release',
      export_method: 'app-store',
      # Numéro de build strictement croissant, comme l'exige Apple: le numéro
      # de run GitHub, même mécanique que versionCode côté Android.
      xcargs: "CURRENT_PROJECT_VERSION=#{build} MARKETING_VERSION=1.0.#{build}",
      output_directory: ENV.fetch('RUNNER_TEMP'),
      clean: true,
    )

    # skip_waiting_for_build_processing: le traitement chez Apple prend de
    # dix minutes à une heure. L'attendre ne changerait rien au résultat et
    # ferait tourner une machine macOS pour rien — elles comptent dix fois
    # plus que les autres dans le quota GitHub.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
